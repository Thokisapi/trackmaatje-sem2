
<link rel="stylesheet" href="~/css/userinfo.css" asp-append-version="true" />
<section class="user-info-page">
    <div class="user-info-grid">
        <div class="panel">
            <h1 class="panel-title">Your Information</h1>
            <p class="panel-subtitle">Enter your physical stats to calculate your personalized plan.</p>

            <form class="user-info-form" method="post">
                <label for="weight">Weight (kg)</label>
                <input id="weight" type="number" step="0.1" name="weight" class="form-control" placeholder="84" />

                <label for="height">Height (cm)</label>
                <input id="height" type="number" name="height" class="form-control" placeholder="187" />

                <label for="age">Age (years)</label>
                <input id="age" type="number" name="age" class="form-control" placeholder="20" />

                <div class="options">
                    <label>Gender</label>
                    <label class="radio-row"><input type="radio" name="gender" value="male" checked /> Male</label>
                    <label class="radio-row"><input type="radio" name="gender" value="female" /> Female</label>
                </div>

                <label for="activityLevel">Activity Level</label>
                <select id="activityLevel" class="form-control" name="activityLevel">
                    <option value="sedentary">Sedentary (little or no exercise)</option>
                    <option value="lightly_active">Lightly active (exercise 1-3 days/week)</option>
                    <option value="moderately_active" selected>Moderate (exercise 3-5 days/week)</option>
                    <option value="very_active">Very active (exercise 6-7 days/week)</option>
                </select>

                <div class="options">
                    <label>Goal</label>
                    <label class="radio-row"><input type="radio" name="goal" value="weight_loss" checked /> Lose Weight</label>
                    <label class="radio-row"><input type="radio" name="goal" value="maintenance" /> Maintain Weight</label>
                    <label class="radio-row"><input type="radio" name="goal" value="muscle_gain" /> Gain Weight</label>
                </div>

                <button type="submit" class="btn btn-success action-btn">Calculate Plan</button>
            </form>
        </div>

        <div class="panel plan-panel">
            <h3 class="panel-title">Your Personalized Plan</h3>
            <p class="panel-subtitle">Daily macro nutrient targets based on your information.</p>

            <div class="plan-placeholder">
                Fill in your information and click "Calculate Plan" to see your personalized targets.
            </div>
        </div>
    </div>
</section>
